{
  "version": 2,
  "buildCommand": "npm run test:web",
  "builds": [
    {
      "src": "api/score.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/batch-score.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/batches.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/database-status.js",
      "use": "@vercel/node"
    },
    {
      "src": "public/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/score",
      "dest": "/api/score.js"
    },
    {
      "src": "/api/batch-score",
      "dest": "/api/batch-score.js"
    },
    {
      "src": "/api/batches",
      "dest": "/api/batches.js"
    },
    {
      "src": "/api/database-status",
      "dest": "/api/database-status.js"
    },
    {
      "src": "/(.*)",
      "dest": "/public/$1",
      "headers": {
        "X-Content-Type-Options": "nosniff",
        "X-Frame-Options": "DENY"
      }
    }
  ]
}
